  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowImportingTsExtensions": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/tests/**"
  ]
}
